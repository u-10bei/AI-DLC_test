# AI-DLC PoC — リバースプロキシ設定（Caddy）
#
# 配置先: /etc/caddy/Caddyfile
# <HOSTNAME> を Azure パブリック IP の DNS ラベル
# （例: <label>.<region>.cloudapp.azure.com）または独自ドメインに置換する。
# Let's Encrypt は名前解決可能なホスト名を要求するため、IP アドレスでは取得できない。
#
# ⚠️ SECURITY-02（アクセスログ）:
#   従来の設計は「既存の公開基盤がアクセスログを提供する」前提だった。
#   自前プロキシ構成ではその前提が成り立たないため、
#   下の log ディレクティブが SECURITY-02 を満たす唯一の手段になる。削除しないこと。
#   （deployment-plan.md §6 / 申し送り DEP-H1）

<HOSTNAME> {
	# TLS: Let's Encrypt から自動取得・自動更新
	tls <ADMIN_EMAIL>

	# SECURITY-02: アクセスログ（必須）
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 10
			roll_keep_for 2160h # 90 日（監査ログの保持期間に揃える）
		}
		format json
	}

	# アプリへ転送。Caddy は X-Forwarded-For / X-Forwarded-Proto を自動付与する。
	# アプリ側は AIDLC_TRUSTED_PROXIES=127.0.0.1 でこのヘッダを信頼する。
	reverse_proxy 127.0.0.1:8000 {
		# 最適化ジョブはポーリングで確認するため、リクエスト自体は短い。
		# 余裕を持たせておく。
		transport http {
			read_timeout 120s
		}
	}

	# 圧縮（バンドル配信）
	encode gzip
}
