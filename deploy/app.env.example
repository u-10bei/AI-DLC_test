# AI-DLC PoC — 環境変数サンプル
#
# 配置先: /etc/aidlc/app.env  （権限 0640、所有 root:aidlc）
# systemd unit から EnvironmentFile= で読み込みます。
#
# ⚠️ 最も事故が多いのは AIDLC_TRUSTED_PROXIES の設定漏れです。
#    未設定だと送信元 IP 判定がリバースプロキシのアドレスになり、
#    許可リストに一致せず「全アクセスが 403」になります（安全側に倒れる設計）。

# --- データベース（Q4=A: SQLite のまま） -----------------------------------
# 暗号化ディスク上のパスを指定すること（SECURITY-01）
AIDLC_DATABASE_URL=sqlite:////srv/aidlc/data/app.db

# --- 監査ログ（追記専用・chattr +a） ---------------------------------------
AIDLC_AUDIT_LOG_PATH=/srv/aidlc/audit/current.jsonl

# --- ネットワーク統制 -------------------------------------------------------
# 研修参加者の送信元グローバル IP / CIDR をカンマ区切りで列挙。
# 空・未設定は「全拒否」（SECURITY-15）。NSG 側の制限と二重化する。
AIDLC_IP_ALLOWLIST=203.0.113.0/24

# リバースプロキシは同一ホストなので 127.0.0.1。
# プロキシが X-Forwarded-For を付与すること。
AIDLC_TRUSTED_PROXIES=127.0.0.1
AIDLC_CLIENT_IP_HEADER=x-forwarded-for

# --- フロントエンド配信（U08-H4） -------------------------------------------
AIDLC_FRONTEND_DIST_PATH=/srv/aidlc/app/src/frontend/dist

# --- ワーカー ---------------------------------------------------------------
AIDLC_WORKER_POLL_SECONDS=2

# --- セキュリティ調整値（通常は既定のままで可） ------------------------------
# AIDLC_SESSION_TTL_SECONDS=28800
# AIDLC_LOCK_THRESHOLD=5
# AIDLC_LOCK_DURATION_SECONDS=900
# AIDLC_RATE_LIMIT_PER_MINUTE=60
# AIDLC_LOGIN_RATE_LIMIT_PER_MINUTE=5
# AIDLC_ARGON2_MEMORY_KIB=19456
# AIDLC_ARGON2_TIME_COST=2
# AIDLC_ARGON2_PARALLELISM=1
